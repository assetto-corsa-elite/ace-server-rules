{
  "schema_version": 1,
  "timezone": "Europe/Paris",
  "cadences": {
    "pre_race": {
      "weekday": "FRIDAY",
      "local_time": "19:00",
      "categories": [
        "practice_highlights",
        "forecast"
      ]
    },
    "post_race": {
      "weekday": "SUNDAY",
      "categories": [
        "qualifying_report",
        "race_results",
        "stewarding_review",
        "race_insights",
        "standings",
        "next_round_forecast"
      ],
      "trigger": "verified_final_stewarding_ready",
      "finalization_deadline": "23:00",
      "timezone": "CET"
    },
    "pre_race_briefing": {
      "weekday": null,
      "local_time": null,
      "categories": [
        "pre_race_briefing"
      ]
    },
    "race_day_announcement": {
      "weekday": "RACE_DAY",
      "local_time": "09:00",
      "timezone": "CET",
      "categories": [
        "pre_race_announcement"
      ]
    },
    "results_announcement": {
      "trigger": "after_complete_results_sequence",
      "categories": [
        "race_results_announcement"
      ],
      "messages": 3
    }
  },
  "schedule_rule": "Friday production/publication follows its explicit timestamp. Post-race availability requires owner-finalized review, verified application and refreshed assets by Sunday 23:00 CET. Publication then requires owner approval or expiry of the acknowledged ready revision notification window (3,600 seconds without owner response). Results announcements wait for complete Results delivery. scheduled_at is only the earliest permitted release and does not bypass these gates.",
  "category_order": [
    "practice_highlights",
    "forecast",
    "pre_race_briefing",
    "qualifying_report",
    "race_results",
    "stewarding_review",
    "race_insights",
    "standings",
    "next_round_forecast",
    "pre_race_announcement",
    "race_results_announcement"
  ],
  "destination_key": "results",
  "max_content_utf16_units": 2000,
  "max_attachments_per_message": 10,
  "late_delivery_rule": "Post due ready sequences until expires_at, if present. Never send archived or cancelled sequences.",
  "producer": "ChatGPT/Codex authors texts, assets, manifests and catalog commits.",
  "consumer": "Championship Manager fetches validated snapshots and schedules Discord delivery.",
  "channels": {
    "results": {
      "ui_label": "Results channel ID",
      "configured_in": "CM UI / persistent local configuration"
    },
    "announcements": {
      "ui_label": "Announcements channel ID",
      "configured_in": "CM UI / persistent local configuration"
    }
  },
  "everyone_policy": {
    "practice_highlights": "first message of practice sequence only",
    "pre_race_announcement": "first message on race day at 09:00 CET",
    "race_results_announcement": "first text message only",
    "all_other_messages": false
  },
  "post_race_release_gate": "Organizer-supplied approved final decisions; verified ACSM time/points application; refreshed official snapshots and dependent content.",
  "stewarding_deadlines": {
    "report_cutoff": {
      "weekday": "SUNDAY",
      "local_time": "15:00",
      "timezone": "CET",
      "managed_by": "MEE6"
    },
    "finalization": {
      "weekday": "SUNDAY",
      "local_time": "23:00",
      "timezone": "CET"
    }
  },
  "stewarding_ui": {
    "channel_keys": [
      "stewarding-panel",
      "sanction-summaries",
      "results-ready-alerts"
    ],
    "role_keys": [
      "league-stewards",
      "super-admins"
    ],
    "organizer_user_id": "configured in CM UI",
    "entrant_source": "existing CM ENTRANTS database"
  },
  "publication_approval": {
    "actor": "owner_user_id",
    "timeout_seconds": 3600,
    "mode": "owner_approval_or_no_response_timeout",
    "manual_publication_control": "owner_only"
  }
}
